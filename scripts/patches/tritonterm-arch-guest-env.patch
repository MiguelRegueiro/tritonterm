+fn guest_locale_environment(lang: Option<&str>, timezone: Option<&str>) -> Vec<(String, String)> {
+    // TRITONTERM_GUEST_LOCALE_TZ_V1: pr-cli deliberately clears the environment
+    // before starting PRoot, so pass the app-selected locale and current phone
+    // timezone explicitly into the guest login environment.
+    let mut env = vec![(
+        "LANG".to_string(),
+        lang.filter(|value| !value.is_empty())
+            .unwrap_or("C.UTF-8")
+            .to_string(),
+    )];
+    if let Some(timezone) = timezone.filter(|value| !value.is_empty()) {
+        env.push(("TZ".to_string(), timezone.to_string()));
+    }
+    env
+}
