+static bool crash_diagnostics_enabled(void)
+{
+	const char *enabled = getenv("PROOT_CRASH_DIAGNOSTICS");
+	return enabled != NULL && strcmp(enabled, "1") == 0;
+}
+
+static bool crash_log_path(char *path, size_t path_size)
+{
+	const char *configured = getenv("PROOT_CRASH_DIAGNOSTICS_FILE");
+	int length;
+
+	if (configured != NULL && configured[0] != '\0')
+		length = snprintf(path, path_size, "%s", configured);
+	else
+		length = snprintf(path, path_size, "%s/crash-log.txt", get_temp_directory());
+
+	return length >= 0 && (size_t) length < path_size;
+}
+
+static void log_crash_recorder_startup(void)
+{
+	char path[PATH_MAX];
+	FILE *log;
+	int write_error = 0;
+
+	if (!crash_diagnostics_enabled())
+		return;
+	if (!crash_log_path(path, sizeof(path)))
+		return;
+	log = fopen(path, "a");
+	if (log == NULL)
+		return;
+	if (fprintf(log, "PROOT_CRASH_RECORDER active output=%s tracer_pid=%d\n", path, getpid()) < 0 || fflush(log) != 0)
+		write_error = errno == 0 ? EIO : errno;
+	if (fclose(log) != 0 && write_error == 0)
+		write_error = errno == 0 ? EIO : errno;
+	if (write_error != 0)
+		return;
+}
