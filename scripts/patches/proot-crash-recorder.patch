+/* Record enough context to identify guest SIGSEGVs without changing their
+ * delivery.  This is opt-in because /proc maps can reveal private paths. */
+static void log_guest_segv(const Tracee *tracee, int wait_status)
+{
+	char log_path[PATH_MAX];
+	char maps_path[PATH_MAX];
+	char status_path[PATH_MAX];
+	siginfo_t siginfo = {};
+	FILE *log;
+	FILE *maps;
+	FILE *status_file;
+	char line[512];
+	unsigned long tgid = 0;
+	size_t maps_bytes = 0;
+	int regs_status;
+	int info_status;
+	int instruction_status;
+	int i;
+	word_t pc;
+	word_t instruction;
+	const Reg arguments[] = { SYSARG_1, SYSARG_2, SYSARG_3, SYSARG_4, SYSARG_5, SYSARG_6 };
+
+	if (!crash_diagnostics_enabled())
+		return;
+	if (!crash_log_path(log_path, sizeof(log_path)))
+		return;
+	info_status = ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &siginfo) < 0 ? -errno : 0;
+	regs_status = fetch_regs((Tracee *) tracee);
+	pc = regs_status == 0 ? peek_reg(tracee, CURRENT, INSTR_POINTER) : 0;
+	errno = 0;
+	instruction = regs_status == 0 ? peek_word(tracee, pc) : 0;
+	instruction_status = regs_status == 0 ? (errno == 0 ? 0 : -errno) : regs_status;
+	int status_path_length = snprintf(status_path, sizeof(status_path), "/proc/%d/status", tracee->pid);
+	if (status_path_length >= 0 && (size_t) status_path_length < sizeof(status_path)) {
+		status_file = fopen(status_path, "r");
+		if (status_file != NULL) {
+			while (fgets(line, sizeof(line), status_file) != NULL) {
+				if (sscanf(line, "Tgid:\t%lu", &tgid) == 1)
+					break;
+			}
+			fclose(status_file);
+		}
+	}
+	log = fopen(log_path, "a");
+	if (log == NULL)
+		return;
+	fprintf(log, "\nGUEST_SIGSEGV scope=guest_tracee pid=%d tgid=%lu vpid=%" PRIu64 " wait_status=0x%x exe=%s si_code=%d si_addr=%p siginfo_status=%d regs_status=%d pc_word_status=%d pc_word=0x%" PRIx64 "\n",
+		tracee->pid, tgid, tracee->vpid, wait_status, tracee->exe ?: "(unknown)", siginfo.si_code,
+		info_status == 0 ? siginfo.si_addr : NULL, info_status, regs_status, instruction_status, (uint64_t) instruction);
+	if (regs_status == 0) {
+		word_t stack_pointer = peek_reg(tracee, CURRENT, STACK_POINTER);
+		fprintf(log, "pc=0x%" PRIx64 " sp=0x%" PRIx64 " x8=0x%" PRIx64,
+			(uint64_t) pc, (uint64_t) stack_pointer,
+			(uint64_t) peek_reg(tracee, CURRENT, SYSARG_NUM));
+		for (i = 0; i < (int) (sizeof(arguments) / sizeof(arguments[0])); i++)
+			fprintf(log, " x%d=0x%" PRIx64, i, (uint64_t) peek_reg(tracee, CURRENT, arguments[i]));
+#if defined(ARCH_ARM64)
+		fprintf(log, " x6=0x%" PRIx64 " x7=0x%" PRIx64,
+			(uint64_t) tracee->_regs[CURRENT].regs[6], (uint64_t) tracee->_regs[CURRENT].regs[7]);
+#endif
+		fputc('\n', log);
+#if defined(ARCH_ARM64)
+		{
+			word_t frame = tracee->_regs[CURRENT].regs[29];
+			for (i = 0; i < 24; i++) {
+				word_t previous;
+				word_t return_address;
+				if (frame < stack_pointer || frame - stack_pointer > 1024 * 1024 || (frame & 0xf) != 0)
+					break;
+				errno = 0;
+				previous = peek_word(tracee, frame);
+				if (errno != 0) break;
+				return_address = peek_word(tracee, frame + sizeof(word_t));
+				if (errno != 0) break;
+				fprintf(log, "frame[%d]=0x%" PRIx64 " return=0x%" PRIx64 "\n",
+					i, (uint64_t) frame, (uint64_t) return_address);
+				if (previous <= frame) break;
+				frame = previous;
+			}
+		}
+#endif
+	}
+	if (snprintf(maps_path, sizeof(maps_path), "/proc/%d/maps", tracee->pid) < (int) sizeof(maps_path)) {
+		maps = fopen(maps_path, "r");
+		if (maps != NULL) {
+			fputs("maps:\n", log);
+			while (maps_bytes < 65536 && fgets(line, sizeof(line), maps) != NULL) {
+				size_t length = strlen(line);
+				if (length > 65536 - maps_bytes)
+					break;
+				fwrite(line, 1, length, log);
+				maps_bytes += length;
+			}
+			fclose(maps);
+		} else {
+			fprintf(log, "maps_unavailable errno=%d\n", errno);
+		}
+	}
+	fflush(log);
+	fclose(log);
+}
