+// TRITONTERM_ANDROID_MOUNT_TABLE_FILTER_V1: Android's /proc/mounts is visible
+// through PRoot's proc bind. Remove host-only /mnt records from the Arch
+// profile's view; Android mounts are not guest devices, but applications such
+// as Elio intentionally display custom top-level mount points. Keep the
+// shared-storage and standard virtual roots while dropping Android's other
+// top-level mounts. /proc/mounts is a symlink to /proc/self/mounts, so its
+// bind destination must end in `!` to prevent PRoot from canonicalizing away
+// this file-level override.
+fn guest_mount_table_contents(contents: &str) -> String {
+    let mut filtered = String::new();
+    for line in contents.lines() {
+        let mut fields = line.split_ascii_whitespace();
+        let Some(_source) = fields.next() else {
+            continue;
+        };
+        let Some(mount_point) = fields.next() else {
+            continue;
+        };
+        if is_android_host_mount_point(mount_point) {
+            continue;
+        }
+        filtered.push_str(line);
+        filtered.push('\n');
+    }
+    filtered
+}
+
+fn is_android_host_mount_point(mount_point: &str) -> bool {
+    if mount_point == "/mnt" || mount_point.starts_with("/mnt/") {
+        return true;
+    }
+    let Some(name) = mount_point.strip_prefix('/') else {
+        return false;
+    };
+    if name.is_empty() || name.contains('/') {
+        return false;
+    }
+    !matches!(name, "dev" | "proc" | "sdcard" | "storage" | "sys")
+}
+
+fn write_guest_mount_table(rootfs: &str, cache_dir: &std::path::Path) -> Option<std::path::PathBuf> {
+    use std::io::Write;
+    use std::os::unix::fs::OpenOptionsExt;
+
+    if !std::path::Path::new(rootfs)
+        .join("etc/tritonterm/proot-userland-metadata-v1")
+        .is_file()
+    {
+        return None;
+    }
+    let contents = std::fs::read_to_string("/proc/mounts").ok()?;
+    let filtered = guest_mount_table_contents(&contents);
+    std::fs::create_dir_all(cache_dir).ok()?;
+
+    let destination = cache_dir.join("tritonterm-guest-mounts");
+    let temporary = cache_dir.join(format!(
+        ".tritonterm-guest-mounts.{}.{}.tmp",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .ok()?
+            .as_nanos()
+    ));
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o644)
+        .open(&temporary)
+        .ok()?;
+    if file.write_all(filtered.as_bytes()).is_err() {
+        let _ = std::fs::remove_file(&temporary);
+        return None;
+    }
+    drop(file);
+    if std::fs::rename(&temporary, &destination).is_err() {
+        let _ = std::fs::remove_file(&temporary);
+        return None;
+    }
+    Some(destination)
+}
