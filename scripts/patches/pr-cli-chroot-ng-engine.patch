+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum LoginEngine {
+    Proot,
+    ChrootNg,
+}
+
+impl LoginEngine {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Proot => "proot",
+            Self::ChrootNg => "chroot-ng",
+        }
+    }
+}
+
+fn selected_arch_engine(
+    requested: Option<&str>,
+    userland_account: bool,
+) -> Result<LoginEngine, String> {
+    if !userland_account {
+        return Ok(LoginEngine::Proot);
+    }
+    match requested {
+        None | Some("") | Some("proot") => Ok(LoginEngine::Proot),
+        Some("chroot-ng") => Ok(LoginEngine::ChrootNg),
+        Some(value) => Err(format!("unsupported Arch engine: {}", value)),
+    }
+}
+
+fn login_engine_binary(engine: LoginEngine, proot: &Path) -> PathBuf {
+    match engine {
+        LoginEngine::Proot => proot.to_path_buf(),
+        LoginEngine::ChrootNg => proot.with_file_name("libchroot-ng.so"),
+    }
+}
+
+fn chroot_ng_bind(specification: &str) -> Result<String, String> {
+    let (source, destination) = specification
+        .split_once(':')
+        .unwrap_or((specification, specification));
+    let destination = destination.strip_suffix('!').unwrap_or(destination);
+    if source.is_empty() || !destination.starts_with('/') || destination.contains(':') {
+        return Err(format!(
+            "chroot-ng cannot represent this bind: {}",
+            specification
+        ));
+    }
+    Ok(format!("--bind={}:{}", source, destination))
+}
+
+fn chroot_ng_login_args(
+    proot_args: &[String],
+    rootfs: &str,
+    no_link2symlink: bool,
+    guest_env: &[(String, String)],
+    guest_command: &[String],
+) -> Result<Vec<String>, String> {
+    let identity = proot_args
+        .iter()
+        .find_map(|arg| arg.strip_prefix("--change-id="))
+        .ok_or_else(|| "login identity is missing".to_string())?;
+    let cwd = proot_args
+        .iter()
+        .find_map(|arg| arg.strip_prefix("--cwd="))
+        .ok_or_else(|| "login working directory is missing".to_string())?;
+    let mut args = vec![
+        "-R".to_string(),
+        format!("--fake-id={}", identity),
+        "--setuid-root".to_string(),
+        "--setgid-root".to_string(),
+        format!("--work-dir={}", cwd),
+    ];
+    if !no_link2symlink {
+        args.push("--link2symlink".to_string());
+    }
+    let binds: Vec<&str> = proot_args
+        .iter()
+        .filter_map(|arg| arg.strip_prefix("--bind="))
+        .collect();
+    if binds.len() > 64 {
+        return Err("chroot-ng supports at most 64 binds".to_string());
+    }
+    for specification in binds.into_iter().rev() {
+        args.push(chroot_ng_bind(specification)?);
+    }
+    if guest_env.len() > 128 {
+        return Err("chroot-ng supports at most 128 guest environment entries".to_string());
+    }
+    for (key, value) in guest_env {
+        args.push(format!("--env={}={}", key, value));
+    }
+    args.push("--".to_string());
+    args.push(rootfs.to_string());
+    args.extend_from_slice(guest_command);
+    Ok(args)
+}
+
+fn chroot_ng_process_env(
+    inherited: impl Iterator<Item = (String, String)>,
+    cache_dir: String,
+) -> Vec<(String, String)> {
+    let mut environment: Vec<(String, String)> = inherited.collect();
+    for (key, value) in [
+        ("TMPDIR", cache_dir),
+        ("CNG_TMP_ENV_ONLY", "1".to_string()),
+        ("TRITONTERM_USERLAND_METADATA", "1".to_string()),
+    ] {
+        environment.retain(|(existing, _)| existing != key);
+        environment.push((key.to_string(), value));
+    }
+    environment
+}
