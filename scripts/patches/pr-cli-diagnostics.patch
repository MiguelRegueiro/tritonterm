new file mode 100644
index 0000000..7bfec08
--- /dev/null
+++ b/src/pr-cli/src/diagnostics.rs
@@ -0,0 +1,84 @@
+use serde_json::Value;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::sync::OnceLock;
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+static STARTED: OnceLock<Instant> = OnceLock::new();
+
+pub fn record(phase: &str, status: &str, details: Value) {
+    let Some(path) = std::env::var_os("TRITONTERM_DIAGNOSTICS_FILE") else {
+        return;
+    };
+    let event = serde_json::json!({
+        "time_unix_ms": SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|duration| duration.as_millis())
+            .unwrap_or_default(),
+        "process_elapsed_ms": STARTED.get_or_init(Instant::now).elapsed().as_millis(),
+        "source": "pr-cli",
+        "phase": phase,
+        "status": status,
+        "details": details,
+    });
+    let Ok(mut line) = serde_json::to_vec(&event) else {
+        return;
+    };
+    line.push(b'\n');
+
+    let result = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .and_then(|mut file| {
+            file.write_all(&line)?;
+            file.sync_data()
+        });
+    if let Err(error) = result {
+        eprintln!("TritonTerm diagnostics write failed: {error}");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+
+    #[test]
+    fn record_appends_a_structured_event_to_the_requested_file() {
+        let _guard = crate::shared::global_test_env_lock()
+            .lock()
+            .expect("lock env");
+        let previous = std::env::var_os("TRITONTERM_DIAGNOSTICS_FILE");
+        let path: PathBuf = std::env::temp_dir().join(format!(
+            "pr-cli-diagnostics-{}-{}.jsonl",
+            std::process::id(),
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .expect("clock")
+                .as_nanos()
+        ));
+        std::env::set_var("TRITONTERM_DIAGNOSTICS_FILE", &path);
+
+        record(
+            "test_phase",
+            "completed",
+            serde_json::json!({ "answer": 42 }),
+        );
+
+        let event: Value =
+            serde_json::from_str(&std::fs::read_to_string(&path).expect("read event"))
+                .expect("decode event");
+        assert_eq!(event["source"], "pr-cli");
+        assert_eq!(event["phase"], "test_phase");
+        assert_eq!(event["status"], "completed");
+        assert_eq!(event["details"]["answer"], 42);
+
+        if let Some(previous) = previous {
+            std::env::set_var("TRITONTERM_DIAGNOSTICS_FILE", previous);
+        } else {
+            std::env::remove_var("TRITONTERM_DIAGNOSTICS_FILE");
+        }
+        let _ = std::fs::remove_file(path);
+    }
+}
