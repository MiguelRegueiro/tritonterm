+static inline uint64_t proot_perf_clock(void)
+{
+	struct timespec value;
+	int saved_errno;
+	int status;
+
+	if (!proot_perf_enabled || !proot_perf_timing_enabled)
+		return 0;
+	saved_errno = errno;
+	status = clock_gettime(CLOCK_MONOTONIC, &value);
+	errno = saved_errno;
+	if (status != 0)
+		return 0;
+	return (uint64_t)value.tv_sec * UINT64_C(1000000000) + (uint64_t)value.tv_nsec;
+}
+
+static inline void proot_perf_elapsed(ProotPerfCounter counter, uint64_t start)
+{
+	uint64_t end;
+	if (start == 0)
+		return;
+	end = proot_perf_clock();
+	if (end >= start)
+		proot_perf_add(counter, end - start);
+}
