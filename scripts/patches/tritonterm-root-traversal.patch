+/// TRITONTERM_ARCH_ROOT_TRAVERSAL_V1: keep `/` searchable for the configured
+/// unprivileged account. Some base rootfs archives ship the root directory as
+/// 0750 root:root, making every otherwise-public absolute path inaccessible.
+/// This changes only guest metadata for `/`, not Android host permissions.
+pub(crate) fn ensure_userland_root_traversable(root: &Path, guest_uid: u32) -> Result<(), String> {
+    if guest_uid == 0 {
+        return Ok(());
+    }
+    let metadata_path = userland_metadata_root(root).join(".proot-meta-file.root");
+    let contents = fs::read_to_string(&metadata_path).map_err(|e| {
+        format!("read guest root ownership metadata {}: {}", metadata_path.display(), e)
+    })?;
+    let mut fields = contents.split_whitespace();
+    let mode_text = fields.next().ok_or_else(|| "guest root metadata has no mode".to_string())?;
+    let uid_text = fields.next().ok_or_else(|| "guest root metadata has no uid".to_string())?;
+    let gid_text = fields.next().ok_or_else(|| "guest root metadata has no gid".to_string())?;
+    let mode = u32::from_str_radix(mode_text, 8)
+        .map_err(|e| format!("invalid guest root mode '{}': {}", mode_text, e))?;
+    let owner = uid_text.parse::<u64>().map_err(|e| format!("invalid guest root uid: {}", e))?;
+    let group = gid_text.parse::<u64>().map_err(|e| format!("invalid guest root gid: {}", e))?;
+    let traversable_mode = mode | 0o005;
+    if traversable_mode != mode {
+        write_userland_metadata_at(&metadata_path, traversable_mode, owner, group, "/")?;
+    }
+    Ok(())
+}
