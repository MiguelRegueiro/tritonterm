+#ifdef USERLAND
+static int handle_fstat_readlink_exit(Tracee *tracee, Sysnum sysnum)
+{
+	char path[PATH_MAX];
+	const char deleted_suffix[] = " (deleted)";
+	word_t result = peek_reg(tracee, CURRENT, SYSARG_RESULT);
+	word_t path_address = peek_reg(tracee, MODIFIED, SYSARG_3);
+	int status;
+
+	poke_reg(tracee, SYSARG_RESULT, 0);
+	if ((int) result <= 0)
+		return result;
+	if (result >= sizeof(path))
+		return -ENAMETOOLONG;
+	status = read_data(tracee, path, path_address, result);
+	if (status < 0)
+		return status;
+	path[result] = '\0';
+
+	if ((result >= sizeof(deleted_suffix) - 1 &&
+	     strcmp(path + result - (sizeof(deleted_suffix) - 1), deleted_suffix) == 0) ||
+	    strncmp(path, "pipe", 4) == 0) {
+		register_chained_syscall(tracee, sysnum, peek_reg(tracee, ORIGINAL, SYSARG_1),
+			peek_reg(tracee, ORIGINAL, SYSARG_2), 0, 0, 0, 0);
+	} else {
+		status = write_data(tracee, path_address + result, "", 1);
+		if (status < 0)
+			return status;
+#	   if defined(__x86_64__)
+		register_chained_syscall(tracee, PR_newfstatat, AT_FDCWD, path_address,
+			peek_reg(tracee, ORIGINAL, SYSARG_2), 0, 0, 0);
+#	   else
+		register_chained_syscall(tracee, PR_fstatat64, AT_FDCWD, path_address,
+			peek_reg(tracee, ORIGINAL, SYSARG_2), 0, 0, 0);
+#	   endif
+	}
+	return 0;
+}
+#endif
