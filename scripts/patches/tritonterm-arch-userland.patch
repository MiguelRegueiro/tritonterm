+fn write_userland_root_metadata(root: &Path, mode: u32, uid: u64, gid: u64) -> Result<(), String> {
+    let path = root.join(".proot-meta-file.");
+    let temporary = root.join(format!(".proot-meta-file.tmp.{}", std::process::id()));
+    let contents = format!("{:o}\n{}\n{}\n", mode & 0o7777, uid, gid);
+    fs::write(&temporary, contents)
+        .map_err(|e| format!("write guest metadata for /: {}", e))?;
+    fs::set_permissions(&temporary, fs::Permissions::from_mode(0o600))
+        .map_err(|e| format!("protect guest metadata for /: {}", e))?;
+    fs::rename(&temporary, &path).map_err(|e| format!("commit guest metadata for /: {}", e))
+}
+
+/// Store archive ownership and mode outside host inode metadata. Android app
+/// storage cannot chown files to guest UID 0 and clears setuid bits, while the
+/// PRoot USERLAND fake_id0 extension reads this per-path record to enforce the
+/// guest's real Unix ownership, permissions, and setuid behavior.
+fn write_userland_metadata(
+    root: &Path,
+    relative: &Path,
+    mode: u32,
+    uid: u64,
+    gid: u64,
+) -> Result<(), String> {
+    let dest = resolve_in_root(root, relative, false)?;
+    let name = dest
+        .file_name()
+        .ok_or_else(|| format!("metadata target has no filename: {}", dest.display()))?;
+    let mut metadata_name = OsString::from_vec(b".proot-meta-file.".to_vec());
+    metadata_name.push(OsString::from_vec(name.as_bytes().to_vec()));
+    let metadata_path = dest
+        .parent()
+        .ok_or_else(|| format!("metadata target has no parent: {}", dest.display()))?
+        .join(metadata_name);
+    let temporary = metadata_path.with_extension(format!("tmp.{}", std::process::id()));
+    let contents = format!("{:o}\n{}\n{}\n", mode & 0o7777, uid, gid);
+    fs::write(&temporary, contents)
+        .map_err(|e| format!("write guest metadata for {}: {}", relative.display(), e))?;
+    fs::set_permissions(&temporary, fs::Permissions::from_mode(0o600))
+        .map_err(|e| format!("protect guest metadata for {}: {}", relative.display(), e))?;
+    fs::rename(&temporary, &metadata_path)
+        .map_err(|e| format!("commit guest metadata for {}: {}", relative.display(), e))
+}
