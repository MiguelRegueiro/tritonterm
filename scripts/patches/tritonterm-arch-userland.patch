+fn userland_metadata_root(root: &Path) -> PathBuf {
+    let mut path = root.as_os_str().to_os_string();
+    path.push(".tritonterm-metadata");
+    PathBuf::from(path)
+}
+
+fn write_userland_root_metadata(root: &Path, mode: u32, uid: u64, gid: u64) -> Result<(), String> {
+    write_userland_metadata_at(
+        &userland_metadata_root(root).join(".proot-meta-file.root"),
+        mode,
+        uid,
+        gid,
+        "/",
+    )
+}
+
+/// Store archive ownership and mode outside host inode metadata. Android app
+/// storage cannot chown files to guest UID 0 and clears setuid bits, while the
+/// PRoot USERLAND fake_id0 extension reads this per-path record to enforce the
+/// guest's real Unix ownership, permissions, and setuid behavior.
+fn write_userland_metadata(
+    root: &Path,
+    relative: &Path,
+    mode: u32,
+    uid: u64,
+    gid: u64,
+) -> Result<(), String> {
+    let dest = resolve_in_root(root, relative, false)?;
+    let name = dest
+        .file_name()
+        .ok_or_else(|| format!("metadata target has no filename: {}", dest.display()))?;
+    let parent = relative.parent().unwrap_or_else(|| Path::new(""));
+    let mut metadata_name = OsString::from_vec(b".proot-meta-file.".to_vec());
+    metadata_name.push(OsString::from_vec(name.as_bytes().to_vec()));
+    let metadata_path = userland_metadata_root(root)
+        .join(parent)
+        .join(metadata_name);
+    write_userland_metadata_at(
+        &metadata_path,
+        mode,
+        uid,
+        gid,
+        &relative.display().to_string(),
+    )
+}
+
+fn write_userland_metadata_at(
+    metadata_path: &Path,
+    mode: u32,
+    uid: u64,
+    gid: u64,
+    guest_path: &str,
+) -> Result<(), String> {
+    let metadata_parent = metadata_path
+        .parent()
+        .ok_or_else(|| format!("metadata target has no parent: {}", metadata_path.display()))?;
+    fs::create_dir_all(metadata_parent)
+        .map_err(|e| format!("create guest metadata directory for {}: {}", guest_path, e))?;
+    let temporary = metadata_path.with_extension(format!("tmp.{}", std::process::id()));
+    let contents = format!("{:o}\n{}\n{}\n", mode & 0o7777, uid, gid);
+    fs::write(&temporary, contents)
+        .map_err(|e| format!("write guest metadata for {}: {}", guest_path, e))?;
+    fs::set_permissions(&temporary, fs::Permissions::from_mode(0o600))
+        .map_err(|e| format!("protect guest metadata for {}: {}", guest_path, e))?;
+    fs::rename(&temporary, &metadata_path)
+        .map_err(|e| format!("commit guest metadata for {}: {}", guest_path, e))
+}
