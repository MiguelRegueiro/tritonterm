+#ifndef PROOT_TRACEE_PERF_H
+#define PROOT_TRACEE_PERF_H
+
+#include <signal.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/types.h>
+
+#define PROOT_PERF_COUNTERS(X) \
+	X(EVENTS, "events") \
+	X(SYSCALL_STOPS, "syscall_stops") \
+	X(SECCOMP_STOPS, "seccomp_stops") \
+	X(SIGSYS_STOPS, "sigsys_stops") \
+	X(PVM_READ_ATTEMPTS, "pvm_read_attempts") \
+	X(PVM_READ_SUCCESS, "pvm_read_success") \
+	X(PVM_READ_BYTES, "pvm_read_bytes") \
+	X(PVM_WRITE_ATTEMPTS, "pvm_write_attempts") \
+	X(PVM_WRITE_SUCCESS, "pvm_write_success") \
+	X(PVM_WRITE_BYTES, "pvm_write_bytes") \
+	X(PTRACE_PEEK_WORDS, "ptrace_peek_words") \
+	X(PTRACE_POKE_WORDS, "ptrace_poke_words") \
+	X(STUB_WRITES, "stub_writes") \
+	X(TRANSLATE_PATH_CALLS, "translate_path_calls") \
+	X(BINDING_COMPARISONS, "binding_comparisons") \
+	X(CANONICAL_COMPONENT_LSTAT, "canonical_component_lstat") \
+	X(F2FS_CHECKS, "f2fs_checks") \
+	X(F2FS_SCANS, "f2fs_scans") \
+	X(F2FS_ENTRIES, "f2fs_entries") \
+	X(F2FS_ACTIVE, "f2fs_active") \
+	X(METADATA_READ_ATTEMPTS, "metadata_read_attempts") \
+	X(METADATA_READ_OPENED, "metadata_read_opened")
+
+typedef enum {
+#define PROOT_PERF_ENUM(id, name) PROOT_PERF_##id,
+	PROOT_PERF_COUNTERS(PROOT_PERF_ENUM)
+#undef PROOT_PERF_ENUM
+	PROOT_PERF_COUNT
+} ProotPerfCounter;
+
+extern volatile sig_atomic_t proot_perf_enabled;
+extern uint64_t proot_perf_counters[PROOT_PERF_COUNT];
+
+static inline void proot_perf_add(ProotPerfCounter counter, uint64_t value)
+{
+	if (proot_perf_enabled)
+		proot_perf_counters[counter] += value;
+}
+
+static inline void proot_perf_set(ProotPerfCounter counter, uint64_t value)
+{
+	if (proot_perf_enabled)
+		proot_perf_counters[counter] = value;
+}
+
+static inline void proot_perf_pvm_result(int write, ssize_t result, size_t requested)
+{
+	if (!proot_perf_enabled)
+		return;
+	proot_perf_counters[write ? PROOT_PERF_PVM_WRITE_ATTEMPTS : PROOT_PERF_PVM_READ_ATTEMPTS]++;
+	if (result > 0)
+		proot_perf_counters[write ? PROOT_PERF_PVM_WRITE_BYTES : PROOT_PERF_PVM_READ_BYTES] += (uint64_t) result;
+	if (result >= 0 && (size_t) result == requested)
+		proot_perf_counters[write ? PROOT_PERF_PVM_WRITE_SUCCESS : PROOT_PERF_PVM_READ_SUCCESS]++;
+}
+
+void proot_perf_init(void);
+void proot_perf_request_snapshot(void);
+void proot_perf_flush_requested(void);
+
+#endif
