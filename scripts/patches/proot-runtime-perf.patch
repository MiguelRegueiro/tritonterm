@@ -0,0 +1,186 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "tracee/perf.h"
+
+volatile sig_atomic_t proot_perf_enabled;
+uint64_t proot_perf_counters[PROOT_PERF_COUNT];
+
+static volatile sig_atomic_t snapshot_requested;
+static int stats_directory = -1;
+static pid_t tracer_pid;
+static uint64_t process_start_ticks;
+static uint64_t sequence;
+static bool signal_installed;
+static struct sigaction previous_usr2;
+
+static const char *const counter_names[] = {
+#define PROOT_PERF_NAME(id, name) name,
+	PROOT_PERF_COUNTERS(PROOT_PERF_NAME)
+#undef PROOT_PERF_NAME
+};
+
+static int read_process_start_ticks(uint64_t *ticks)
+{
+	char buffer[4096];
+	FILE *stream = fopen("/proc/self/stat", "r");
+	char *cursor, *end;
+	if (stream == NULL)
+		return -1;
+	bool read_ok = fgets(buffer, sizeof(buffer), stream) != NULL;
+	int close_status = fclose(stream);
+	if (!read_ok || close_status != 0)
+		return -1;
+	cursor = strrchr(buffer, ')');
+	if (cursor == NULL)
+		return -1;
+	cursor++;
+	for (int field = 3; field < 22; field++) {
+		while (*cursor == ' ')
+			cursor++;
+		if (*cursor == '\0' || *cursor == '\n')
+			return -1;
+		cursor = strchr(cursor, ' ');
+		if (cursor == NULL)
+			return -1;
+	}
+	while (*cursor == ' ')
+		cursor++;
+	if (*cursor < '0' || *cursor > '9')
+		return -1;
+	errno = 0;
+	uint64_t parsed = strtoull(cursor, &end, 10);
+	if (errno != 0 || end == cursor || (*end != ' ' && *end != '\n' && *end != '\0'))
+		return -1;
+	*ticks = parsed;
+	return 0;
+}
+
+static int write_snapshot(uint64_t next_sequence)
+{
+	char record[4096], filename[64], temporary[96];
+	int length = snprintf(record, sizeof(record),
+		"{\"version\":1,\"tracer_pid\":%ld,\"process_start_ticks\":%" PRIu64
+		",\"sequence\":%" PRIu64 ",\"counters\":{",
+		(long) tracer_pid, process_start_ticks, next_sequence);
+	if (length < 0 || (size_t) length >= sizeof(record))
+		return -1;
+	size_t used = (size_t) length;
+	for (size_t i = 0; i < PROOT_PERF_COUNT; i++) {
+		length = snprintf(record + used, sizeof(record) - used, "%s\"%s\":%" PRIu64,
+			i ? "," : "", counter_names[i], proot_perf_counters[i]);
+		if (length < 0 || (size_t) length >= sizeof(record) - used)
+			return -1;
+		used += (size_t) length;
+	}
+	if (sizeof(record) - used < 4)
+		return -1;
+	memcpy(record + used, "}}\n", 3);
+	used += 3;
+	length = snprintf(filename, sizeof(filename), "proot-perf-%ld.json", (long) tracer_pid);
+	if (length < 0 || (size_t) length >= sizeof(filename))
+		return -1;
+	length = snprintf(temporary, sizeof(temporary), ".proot-perf-%ld-%" PRIu64 ".tmp",
+		(long) tracer_pid, next_sequence);
+	if (length < 0 || (size_t) length >= sizeof(temporary))
+		return -1;
+	int fd = openat(stats_directory, temporary, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return -1;
+	size_t offset = 0;
+	int status = -1;
+	while (offset < used) {
+		ssize_t written = write(fd, record + offset, used - offset);
+		if (written < 0 && errno == EINTR)
+			continue;
+		if (written <= 0)
+			goto out;
+		offset += (size_t) written;
+	}
+	status = close(fd);
+	fd = -1;
+	if (status == 0)
+		status = renameat(stats_directory, temporary, stats_directory, filename);
+out:
+	if (fd >= 0)
+		(void) close(fd);
+	if (status != 0)
+		(void) unlinkat(stats_directory, temporary, 0);
+	else
+		sequence = next_sequence;
+	return status;
+}
+
+void proot_perf_request_snapshot(void)
+{
+	if (proot_perf_enabled)
+		snapshot_requested = 1;
+}
+
+static void request_signal(int signum)
+{
+	(void) signum;
+	proot_perf_request_snapshot();
+}
+
+void proot_perf_init(void)
+{
+	int saved_errno = errno;
+	proot_perf_enabled = 0;
+	snapshot_requested = 0;
+	if (signal_installed) {
+		(void) sigaction(SIGUSR2, &previous_usr2, NULL);
+		signal_installed = false;
+	}
+	if (stats_directory >= 0) {
+		(void) close(stats_directory);
+		stats_directory = -1;
+	}
+	memset(proot_perf_counters, 0, sizeof(proot_perf_counters));
+	sequence = 0;
+	const char *directory = getenv("PROOT_PERF_STATS_DIR");
+	if (directory == NULL || directory[0] != '/' || strlen(directory) >= PATH_MAX)
+		goto out;
+	if (read_process_start_ticks(&process_start_ticks) != 0)
+		goto out;
+	stats_directory = open(directory, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+	if (stats_directory < 0)
+		goto out;
+	tracer_pid = getpid();
+	struct sigaction action;
+	memset(&action, 0, sizeof(action));
+	action.sa_handler = request_signal;
+	action.sa_flags = SA_RESTART;
+	if (sigfillset(&action.sa_mask) != 0 || sigaction(SIGUSR2, &action, &previous_usr2) != 0)
+		goto failed;
+	signal_installed = true;
+	proot_perf_enabled = 1;
+	if (write_snapshot(0) == 0)
+		goto out;
+	proot_perf_enabled = 0;
+	(void) sigaction(SIGUSR2, &previous_usr2, NULL);
+	signal_installed = false;
+failed:
+	(void) close(stats_directory);
+	stats_directory = -1;
+out:
+	errno = saved_errno;
+}
+
+void proot_perf_flush_requested(void)
+{
+	int saved_errno = errno;
+	if (proot_perf_enabled && snapshot_requested && getpid() == tracer_pid) {
+		snapshot_requested = 0;
+		(void) write_snapshot(sequence + 1);
+	}
+	errno = saved_errno;
+}
