+/// TRITONTERM_ANDROID_NETWORK_DNS_V1: consume Android's VPN DNS search suffixes.
+/// Search domains Android assigned to the active network, passed by the app as a comma-separated list.
+pub fn network_dns_search_domains() -> Vec<String> {
+    std::env::var("APP_DNS_SEARCH_DOMAINS")
+        .map(|value| value.split(',').filter_map(valid_search_domain).collect())
+        .unwrap_or_default()
+}
+
+fn valid_search_domain(raw: &str) -> Option<String> {
+    let domain = raw.trim().trim_end_matches('.').to_ascii_lowercase();
+    if domain.is_empty() || domain.len() > 253 || !domain.is_ascii() {
+        return None;
+    }
+    let valid = domain.split('.').all(|label| {
+        !label.is_empty()
+            && label.len() <= 63
+            && label.as_bytes()[0].is_ascii_alphanumeric()
+            && label.as_bytes()[label.len() - 1].is_ascii_alphanumeric()
+            && label
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-')
+    });
+    valid.then_some(domain)
+}
